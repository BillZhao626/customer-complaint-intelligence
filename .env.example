# Do not commit real API keys. Copy this file to .env locally and fill in your own key.
LLM_ENABLE_API=false
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_with_your_api_key
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200

# P2 Single Analysis gate, independent of legacy LLM_ENABLE_API.
# Requires the pre-authorized synthetic pilot ledger; key alone never enables P2 calls.
COMPLAINT_ENABLE_LIVE=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING=false
# Optional: COMPLAINT_DB_PATH=.local/p2-pilot-v1/runs.sqlite3
# P3 offline demo: use a NEW directory from scripts/p3_demo.py.
# COMPLAINT_DB_PATH=.local/p3-demo/runs.sqlite3
# COMPLAINT_DATASET_MANIFEST=.local/p3-demo/dataset.json
# P2 Dashboard reads saved run JSON directly; do not point the writable Single
# Analysis database at a frozen historical database just to inspect results.
# P2 deliberately freezes deepseek-flash, thinking=disabled, max_tokens=1800,
# HTTP timeout=45s, logical deadline=90s, SDK retries=0, attempts<=2.
# Legacy model/prompt settings above remain for historical entry points only.
